# Copy to .env and fill in. .env is gitignored; this file is not.
# Fields with no default are REQUIRED - the app refuses to start without them.

# --- LLM ---
# REQUIRED
GROQ_API_KEY=<groq key>
# REQUIRED
GOOGLE_API_KEY=<google ai studio key - https://aistudio.google.com/apikey>

# --- TOOLS ---
# REQUIRED
TAVILY_API_KEY=<tavily key>

# --- SUPABASE ---
# REQUIRED
SUPABASE_URL=https://<project>.supabase.co
# REQUIRED
SUPABASE_SERVICE_KEY=<service-role key - server only, never ship to a browser>
# optional, default: ''
SUPABASE_JWT_KEY=<jwt secret - optional until we verify user JWTs>

# --- OBSERVABILITY (Langfuse) ---
# optional, default: '' - from Project Settings > API Keys
LANGFUSE_PUBLIC_KEY=<pk-lf-...>
# optional, default: ''
LANGFUSE_SECRET_KEY=<sk-lf-...>
# optional, default: 'https://cloud.langfuse.com'
# EU cloud: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com
# self-hosted: http://localhost:3000
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# optional, default: 'development' - separates traces per deploy environment
LANGFUSE_ENVIRONMENT=development
# optional, default: True - tracing enables itself once both keys are set;
# set false to keep it off without removing them
LANGFUSE_TRACING=True

# --- APP ---
# optional, default: []
CORS_ORIGINS=[]

