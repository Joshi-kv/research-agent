# Copy to .env and fill in. .env is gitignored; this file is not.
# Fields with no default are REQUIRED - the app refuses to start without them.

# --- LLM ---
# REQUIRED
GROQ_API_KEY=<groq key>
# REQUIRED
GOOGLE_API_KEY=<google ai studio key - https://aistudio.google.com/apikey>

# --- TOOLS ---
# REQUIRED
TAVILY_API_KEY=<tavily key>

# --- SUPABASE ---
# REQUIRED
SUPABASE_URL=https://<project>.supabase.co
# REQUIRED
SUPABASE_SERVICE_KEY=<service-role key - server only, never ship to a browser>
# optional, default: ''
SUPABASE_JWT_KEY=<jwt secret - optional until we verify user JWTs>

# --- OBSERVABILITY ---
# optional, default: ''
LANGSMITH_API_KEY=<langsmith key - leave blank to disable tracing>
# optional, default: False
LANGSMITH_TRACING=False
# optional, default: 'research-assistant'
LANGSMITH_PROJECT=research-assistant

# --- APP ---
# optional, default: []
CORS_ORIGINS=[]

