# The `http://` scheme prefix is critical: it forces plain-HTTP mode even if
# $PORT is missing or empty on the platform, so Caddy binds :80 (or the value
# of $PORT) and never falls back to HTTPS/ACME (which would crash with exit
# 255). `:{$PORT:80}` alone would adapt to :443 in that case.
http://:{$PORT:80} {
	# Serve the built SPA
	root * /usr/share/caddy
	encode gzip zstd

	# API routes → backend. {$BACKEND_UPSTREAM} is injected via env (Render sets
	# it to the backend service URL, e.g. https://backend.onrender.com); defaults
	# to localhost for local compose. flush_interval -1 flushes SSE chunks so the
	# research stream reaches the browser live (no buffering). A single @api
	# matcher keeps all reverse_proxy routes in one handle block.
	@api {
		path /research*
		path /health*
	}
	handle @api {
		reverse_proxy {$BACKEND_UPSTREAM:http://backend:8000} {
			flush_interval -1
		}
	}

	# SPA: serve built assets with index.html fallback for client-side routes.
	handle {
		try_files {path} /index.html
		file_server
	}
}