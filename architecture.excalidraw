    {
      "id": "p_code1_b",
      "type": "text",
      "x": 892,
      "y": 3332,
      "width": 600,
      "height": 390,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "import httpx\nfrom bs4 import BeautifulSoup\nfrom langchain_core.tools import tool\nfrom tavily import TavilyClient\n\nfrom research_agent.config.settings import get_settings\n\n@tool\ndef search_web(query: str, max_results: int = 5) -> list[dict]:\n    \"\"\"Search the web and return {title, url, snippet} results.\"\"\"\n    client = TavilyClient(api_key=get_settings().tavily_api_key)\n    hits = client.search(query, max_results=max_results)[\"results\"]\n    return [{\"title\": h[\"title\"], \"url\": h[\"url\"],\n             \"snippet\": h[\"content\"]} for h in hits]\n\n@tool\nasync def scrape_content(url: str) -> str:\n    \"\"\"Fetch a page and return its readable text.\"\"\"\n    async with httpx.AsyncClient(timeout=20, follow_redirects=True) as c:\n        html = (await c.get(url)).text\n    soup = BeautifulSoup(html, \"html.parser\")\n    for tag in soup([\"script\", \"style\", \"nav\", \"footer\"]):\n        tag.decompose()\n    return \" \".join(soup.get_text(\" \").split())[:20_000]",
      "originalText": "import httpx\nfrom bs4 import BeautifulSoup\nfrom langchain_core.tools import tool\nfrom tavily import TavilyClient\n\nfrom research_agent.config.settings import get_settings\n\n@tool\ndef search_web(query: str, max_results: int = 5) -> list[dict]:\n    \"\"\"Search the web and return {title, url, snippet} results.\"\"\"\n    client = TavilyClient(api_key=get_settings().tavily_api_key)\n    hits = client.search(query, max_results=max_results)[\"results\"]\n    return [{\"title\": h[\"title\"], \"url\": h[\"url\"],\n             \"snippet\": h[\"content\"]} for h in hits]\n\n@tool\nasync def scrape_content(url: str) -> str:\n    \"\"\"Fetch a page and return its readable text.\"\"\"\n    async with httpx.AsyncClient(timeout=20, follow_redirects=True) as c:\n        html = (await c.get(url)).text\n    soup = BeautifulSoup(html, \"html.parser\")\n    for tag in soup([\"script\", \"style\", \"nav\", \"footer\"]):\n        tag.decompose()\n    return \" \".join(soup.get_text(\" \").split())[:20_000]",
