      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "from supabase import create_client\n\nfrom research_agent.config.settings import get_settings\nfrom research_agent.core.enums import StatusEnum\n\ns = get_settings()\ndb = create_client(s.supabase_url, s.supabase_key)\n\nTABLE = \"research_tasks\"\n\ndef insert_task(query: str) -> dict:\n    row = {\"query\": query, \"status\": StatusEnum.PENDING}\n    return db.table(TABLE).insert(row).execute().data[0]\n\ndef update_task(task_id: str, **fields) -> dict:\n    return (db.table(TABLE)\n              .update(fields)\n              .eq(\"id\", task_id)\n              .execute().data[0])\n\ndef fetch_task(task_id: str) -> dict | None:\n    res = db.table(TABLE).select(\"*\").eq(\"id\", task_id).execute()\n    return res.data[0] if res.data else None",
      "originalText": "from supabase import create_client\n\nfrom research_agent.config.settings import get_settings\nfrom research_agent.core.enums import StatusEnum\n\ns = get_settings()\ndb = create_client(s.supabase_url, s.supabase_key)\n\nTABLE = \"research_tasks\"\n\ndef insert_task(query: str) -> dict:\n    row = {\"query\": query, \"status\": StatusEnum.PENDING}\n    return db.table(TABLE).insert(row).execute().data[0]\n\ndef update_task(task_id: str, **fields) -> dict:\n    return (db.table(TABLE)\n              .update(fields)\n              .eq(\"id\", task_id)\n              .execute().data[0])\n\ndef fetch_task(task_id: str) -> dict | None:\n    res = db.table(TABLE).select(\"*\").eq(\"id\", task_id).execute()\n    return res.data[0] if res.data else None",
