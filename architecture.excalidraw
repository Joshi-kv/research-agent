      "fontSize": 13,
      "fontFamily": 3,
      "text": "from functools import lru_cache\n\nfrom langchain_groq import ChatGroq\n\nfrom research_agent.config.settings import get_settings\n\n# cheap model for routing/extraction, larger one for writing\nMODEL_BY_ROLE = {\n    \"router\":    \"llama-3.1-8b-instant\",\n    \"search\":    \"llama-3.3-70b-versatile\",\n    \"scraper\":   \"llama-3.1-8b-instant\",\n    \"synthesis\": \"llama-3.3-70b-versatile\",\n}\n\n@lru_cache\ndef get_llm(role: str = \"synthesis\",\n            temperature: float = 0.0) -> ChatGroq:\n    s = get_settings()\n    return ChatGroq(\n        model=MODEL_BY_ROLE.get(role, s.groq_model),\n        api_key=s.groq_api_key,\n        temperature=temperature,\n        max_retries=3,\n        timeout=60,\n    )",
      "originalText": "from functools import lru_cache\n\nfrom langchain_groq import ChatGroq\n\nfrom research_agent.config.settings import get_settings\n\n# cheap model for routing/extraction, larger one for writing\nMODEL_BY_ROLE = {\n    \"router\":    \"llama-3.1-8b-instant\",\n    \"search\":    \"llama-3.3-70b-versatile\",\n    \"scraper\":   \"llama-3.1-8b-instant\",\n    \"synthesis\": \"llama-3.3-70b-versatile\",\n}\n\n@lru_cache\ndef get_llm(role: str = \"synthesis\",\n            temperature: float = 0.0) -> ChatGroq:\n    s = get_settings()\n    return ChatGroq(\n        model=MODEL_BY_ROLE.get(role, s.groq_model),\n        api_key=s.groq_api_key,\n        temperature=temperature,\n        max_retries=3,\n        timeout=60,\n    )",
