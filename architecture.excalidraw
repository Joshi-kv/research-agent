    {
      "id": "p_db9_b",
      "type": "text",
      "x": 892,
      "y": 7225,
      "width": 428,
      "height": 488,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "# core/enums.py\nfrom enum import StrEnum\n\nclass StatusEnum(StrEnum):\n    PENDING      = \"pending\"\n    SEARCHING    = \"searching\"\n    SCRAPING     = \"scraping\"\n    SYNTHESIZING = \"synthesizing\"\n    COMPLETED    = \"completed\"\n    FAILED       = \"failed\"\n\n# api/v1/research/schemas.py\nfrom datetime import datetime\nfrom pydantic import BaseModel, Field\n\nclass ResearchRequest(BaseModel):\n    query: str = Field(min_length=8, max_length=500)\n    max_sources: int = Field(default=5, ge=1, le=15)\n\nclass SourceOut(BaseModel):\n    url: str\n    title: str | None = None\n\nclass ResearchResponse(BaseModel):\n    id: str\n    query: str\n    status: StatusEnum\n    sources: list[SourceOut] = []\n    final_report: str | None = None\n    created_at: datetime",
      "originalText": "# core/enums.py\nfrom enum import StrEnum\n\nclass StatusEnum(StrEnum):\n    PENDING      = \"pending\"\n    SEARCHING    = \"searching\"\n    SCRAPING     = \"scraping\"\n    SYNTHESIZING = \"synthesizing\"\n    COMPLETED    = \"completed\"\n    FAILED       = \"failed\"\n\n# api/v1/research/schemas.py\nfrom datetime import datetime\nfrom pydantic import BaseModel, Field\n\nclass ResearchRequest(BaseModel):\n    query: str = Field(min_length=8, max_length=500)\n    max_sources: int = Field(default=5, ge=1, le=15)\n\nclass SourceOut(BaseModel):\n    url: str\n    title: str | None = None\n\nclass ResearchResponse(BaseModel):\n    id: str\n    query: str\n    status: StatusEnum\n    sources: list[SourceOut] = []\n    final_report: str | None = None\n    created_at: datetime",
