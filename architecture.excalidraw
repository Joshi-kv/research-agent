    },
    {
      "id": "p_code4_b",
      "type": "text",
      "x": 24,
      "y": 4371,
      "width": 575,
      "height": 504,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "import json\nfrom fastapi import APIRouter, BackgroundTasks, HTTPException\nfrom fastapi.responses import StreamingResponse\n\nfrom research_agent.api.v1.research.schemas import (\n    ResearchRequest, ResearchResponse)\nfrom research_agent.services.research_service import (\n    create_task, get_task, run_task, subscribe)\n\nrouter = APIRouter(prefix=\"/research\", tags=[\"research\"])\n\n@router.post(\"\", response_model=ResearchResponse, status_code=202)\nasync def start_research(req: ResearchRequest, bg: BackgroundTasks):\n    task = await create_task(req.query)\n    bg.add_task(run_task, task.id)          # async, non-blocking\n    return task\n\n@router.get(\"/{research_id}\", response_model=ResearchResponse)\nasync def read_research(research_id: str):\n    task = await get_task(research_id)\n    if task is None:\n        raise HTTPException(404, \"research task not found\")\n    return task\n\n@router.get(\"/{research_id}/stream\")\nasync def stream_research(research_id: str):\n    async def events():\n        async for ev in subscribe(research_id):\n            yield f\"event: {ev.name}\\ndata: {json.dumps(ev.data)}\\n\\n\"\n    return StreamingResponse(events(),\n                             media_type=\"text/event-stream\")",
      "originalText": "import json\nfrom fastapi import APIRouter, BackgroundTasks, HTTPException\nfrom fastapi.responses import StreamingResponse\n\nfrom research_agent.api.v1.research.schemas import (\n    ResearchRequest, ResearchResponse)\nfrom research_agent.services.research_service import (\n    create_task, get_task, run_task, subscribe)\n\nrouter = APIRouter(prefix=\"/research\", tags=[\"research\"])\n\n@router.post(\"\", response_model=ResearchResponse, status_code=202)\nasync def start_research(req: ResearchRequest, bg: BackgroundTasks):\n    task = await create_task(req.query)\n    bg.add_task(run_task, task.id)          # async, non-blocking\n    return task\n\n@router.get(\"/{research_id}\", response_model=ResearchResponse)\nasync def read_research(research_id: str):\n    task = await get_task(research_id)\n    if task is None:\n        raise HTTPException(404, \"research task not found\")\n    return task\n\n@router.get(\"/{research_id}/stream\")\nasync def stream_research(research_id: str):\n    async def events():\n        async for ev in subscribe(research_id):\n            yield f\"event: {ev.name}\\ndata: {json.dumps(ev.data)}\\n\\n\"\n    return StreamingResponse(events(),\n                             media_type=\"text/event-stream\")",
