    {
      "id": "p_db2_b",
      "type": "text",
      "x": 24,
      "y": 5975,
      "width": 567,
      "height": 390,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "from research_agent.integrations.supabase import table\n\nTABLE = \"sources\"\n\ndef bulk_upsert(research_id: str, sources: list[dict]) -> list[dict]:\n    rows = [{\"research_id\": research_id,\n             \"url\": s[\"url\"],\n             \"title\": s.get(\"title\"),\n             \"snippet\": s.get(\"snippet\")} for s in sources]\n    return (table(TABLE)\n            .upsert(rows, on_conflict=\"research_id,url\")\n            .execute().data)\n\ndef save_content(source_id: str, content: str) -> dict:\n    return (table(TABLE)\n            .update({\"scraped_content\": content})\n            .eq(\"id\", source_id)\n            .execute().data[0])\n\ndef list_for_task(research_id: str) -> list[dict]:\n    return (table(TABLE).select(\"*\")\n            .eq(\"research_id\", research_id)\n            .order(\"created_at\")\n            .execute().data)",
      "originalText": "from research_agent.integrations.supabase import table\n\nTABLE = \"sources\"\n\ndef bulk_upsert(research_id: str, sources: list[dict]) -> list[dict]:\n    rows = [{\"research_id\": research_id,\n             \"url\": s[\"url\"],\n             \"title\": s.get(\"title\"),\n             \"snippet\": s.get(\"snippet\")} for s in sources]\n    return (table(TABLE)\n            .upsert(rows, on_conflict=\"research_id,url\")\n            .execute().data)\n\ndef save_content(source_id: str, content: str) -> dict:\n    return (table(TABLE)\n            .update({\"scraped_content\": content})\n            .eq(\"id\", source_id)\n            .execute().data[0])\n\ndef list_for_task(research_id: str) -> list[dict]:\n    return (table(TABLE).select(\"*\")\n            .eq(\"research_id\", research_id)\n            .order(\"created_at\")\n            .execute().data)",
