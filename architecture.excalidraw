    {
      "id": "p_code2_b",
      "type": "text",
      "x": 24,
      "y": 3803,
      "width": 633,
      "height": 422,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "from langchain.agents import create_agent\nfrom langchain_groq import ChatGroq\n\nfrom research_agent.config.settings import get_settings\nfrom research_agent.tools.search import search_web, scrape_content\n\ndef make_llm(model: str | None = None, temperature: float = 0.0) -> ChatGroq:\n    s = get_settings()\n    return ChatGroq(model=model or s.groq_model,\n                    api_key=s.groq_api_key,\n                    temperature=temperature)\n\nsearch_agent = create_agent(\n    model=make_llm(),\n    tools=[search_web],\n    system_prompt=(\n        \"You find the most relevant, recent sources for a research \"\n        \"question. Call search_web, then return the best 5 URLs.\"\n    ),\n)\n\nscraper_agent = create_agent(\n    model=make_llm(),\n    tools=[scrape_content],\n    system_prompt=\"Extract the factual content of each URL given.\",\n)",
      "originalText": "from langchain.agents import create_agent\nfrom langchain_groq import ChatGroq\n\nfrom research_agent.config.settings import get_settings\nfrom research_agent.tools.search import search_web, scrape_content\n\ndef make_llm(model: str | None = None, temperature: float = 0.0) -> ChatGroq:\n    s = get_settings()\n    return ChatGroq(model=model or s.groq_model,\n                    api_key=s.groq_api_key,\n                    temperature=temperature)\n\nsearch_agent = create_agent(\n    model=make_llm(),\n    tools=[search_web],\n    system_prompt=(\n        \"You find the most relevant, recent sources for a research \"\n        \"question. Call search_web, then return the best 5 URLs.\"\n    ),\n)\n\nscraper_agent = create_agent(\n    model=make_llm(),\n    tools=[scrape_content],\n    system_prompt=\"Extract the factual content of each URL given.\",\n)",
