    {
      "id": "p_tree_b",
      "type": "text",
      "x": 28,
      "y": 1569,
      "width": 723,
      "height": 878,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": ".\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 .env / .env.example\n\u251c\u2500\u2500 docker-compose.yml\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 research_agent/\n\u2502       \u251c\u2500\u2500 main.py                    # FastAPI entry, app factory, router registration\n\u2502       \u251c\u2500\u2500 config/\n\u2502       \u2502   \u2514\u2500\u2500 settings.py            # pydantic-settings (env)\n\u2502       \u251c\u2500\u2500 api/                       # presentation layer\n\u2502       \u2502   \u251c\u2500\u2500 dependencies.py        # DI / Supabase & LLM deps\n\u2502       \u2502   \u251c\u2500\u2500 middleware.py          # CORS, logging, error handlers\n\u2502       \u2502   \u2514\u2500\u2500 v1/\n\u2502       \u2502       \u251c\u2500\u2500 router.py          # v1 aggregate router\n\u2502       \u2502       \u2514\u2500\u2500 research/\n\u2502       \u2502           \u251c\u2500\u2500 routes.py      # POST/GET + stream endpoints\n\u2502       \u2502           \u2514\u2500\u2500 schemas.py     # request/response Pydantic\n\u2502       \u251c\u2500\u2500 core/                      # domain layer\n\u2502       \u2502   \u251c\u2500\u2500 entities.py            # ResearchTask, Source models\n\u2502       \u2502   \u2514\u2500\u2500 enums.py               # StatusEnum\n\u2502       \u251c\u2500\u2500 services/                  # application layer\n\u2502       \u2502   \u251c\u2500\u2500 research_service.py    # orchestration entry, state transitions\n\u2502       \u2502   \u251c\u2500\u2500 orchestrator.py        # AgentExecutor pipeline (LangSmith-traced)\n\u2502       \u2502   \u2514\u2500\u2500 streaming.py           # SSE event helpers\n\u2502       \u251c\u2500\u2500 agents/                    # LLM agents\n\u2502       \u2502   \u251c\u2500\u2500 base.py                # shared create_agent() factory\n\u2502       \u2502   \u251c\u2500\u2500 search_agent.py        # Tavily agent\n\u2502       \u2502   \u251c\u2500\u2500 scraper_agent.py       # BeautifulSoup agent\n\u2502       \u2502   \u2514\u2500\u2500 synthesis_agent.py     # writer/report agent\n\u2502       \u251c\u2500\u2500 tools/                     # LangChain @tool definitions\n\u2502       \u2502   \u251c\u2500\u2500 search.py\n\u2502       \u2502   \u251c\u2500\u2500 scrape.py\n\u2502       \u2502   \u2514\u2500\u2500 summarize.py\n\u2502       \u251c\u2500\u2500 integrations/              # infrastructure layer\n\u2502       \u2502   \u251c\u2500\u2500 llm.py                 # LangChain/Groq model factory\n\u2502       \u2502   \u251c\u2500\u2500 langsmith.py           # tracing client + run/project config\n\u2502       \u2502   \u251c\u2500\u2500 supabase.py            # Supabase client\n\u2502       \u2502   \u2514\u2500\u2500 web.py                 # HTTP client, retry/timeout\n\u2502       \u251c\u2500\u2500 repositories/              # data access\n\u2502       \u2502   \u251c\u2500\u2500 task_repo.py           # research_tasks CRUD\n\u2502       \u2502   \u2514\u2500\u2500 source_repo.py         # sources CRUD\n\u2502       \u251c\u2500\u2500 eval/                      # LangSmith eval datasets + evaluators\n\u2502       \u2502   \u251c\u2500\u2500 datasets.py\n\u2502       \u2502   \u251c\u2500\u2500 evaluators.py\n\u2502       \u2502   \u2514\u2500\u2500 run_eval.py\n\u2502       \u2514\u2500\u2500 workers/                   # background jobs\n\u2502           \u2514\u2500\u2500 research_worker.py     # async task runner\n\u251c\u2500\u2500 supabase/\n\u2502   \u2514\u2500\u2500 migrations/\n\u2502       \u2514\u2500\u2500 0001_init.sql              # tables, enum, indexes, RLS\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 conftest.py\n\u2502   \u2514\u2500\u2500 unit/  \u00b7  integration/  \u00b7  e2e/\n\u2514\u2500\u2500 alembic/                           # optional, if you outgrow Supabase migrations",
      "originalText": ".\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 .env / .env.example\n\u251c\u2500\u2500 docker-compose.yml\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 research_agent/\n\u2502       \u251c\u2500\u2500 main.py                    # FastAPI entry, app factory, router registration\n\u2502       \u251c\u2500\u2500 config/\n\u2502       \u2502   \u2514\u2500\u2500 settings.py            # pydantic-settings (env)\n\u2502       \u251c\u2500\u2500 api/                       # presentation layer\n\u2502       \u2502   \u251c\u2500\u2500 dependencies.py        # DI / Supabase & LLM deps\n\u2502       \u2502   \u251c\u2500\u2500 middleware.py          # CORS, logging, error handlers\n\u2502       \u2502   \u2514\u2500\u2500 v1/\n\u2502       \u2502       \u251c\u2500\u2500 router.py          # v1 aggregate router\n\u2502       \u2502       \u2514\u2500\u2500 research/\n\u2502       \u2502           \u251c\u2500\u2500 routes.py      # POST/GET + stream endpoints\n\u2502       \u2502           \u2514\u2500\u2500 schemas.py     # request/response Pydantic\n\u2502       \u251c\u2500\u2500 core/                      # domain layer\n\u2502       \u2502   \u251c\u2500\u2500 entities.py            # ResearchTask, Source models\n\u2502       \u2502   \u2514\u2500\u2500 enums.py               # StatusEnum\n\u2502       \u251c\u2500\u2500 services/                  # application layer\n\u2502       \u2502   \u251c\u2500\u2500 research_service.py    # orchestration entry, state transitions\n\u2502       \u2502   \u251c\u2500\u2500 orchestrator.py        # AgentExecutor pipeline (LangSmith-traced)\n\u2502       \u2502   \u2514\u2500\u2500 streaming.py           # SSE event helpers\n\u2502       \u251c\u2500\u2500 agents/                    # LLM agents\n\u2502       \u2502   \u251c\u2500\u2500 base.py                # shared create_agent() factory\n\u2502       \u2502   \u251c\u2500\u2500 search_agent.py        # Tavily agent\n\u2502       \u2502   \u251c\u2500\u2500 scraper_agent.py       # BeautifulSoup agent\n\u2502       \u2502   \u2514\u2500\u2500 synthesis_agent.py     # writer/report agent\n\u2502       \u251c\u2500\u2500 tools/                     # LangChain @tool definitions\n\u2502       \u2502   \u251c\u2500\u2500 search.py\n\u2502       \u2502   \u251c\u2500\u2500 scrape.py\n\u2502       \u2502   \u2514\u2500\u2500 summarize.py\n\u2502       \u251c\u2500\u2500 integrations/              # infrastructure layer\n\u2502       \u2502   \u251c\u2500\u2500 llm.py                 # LangChain/Groq model factory\n\u2502       \u2502   \u251c\u2500\u2500 langsmith.py           # tracing client + run/project config\n\u2502       \u2502   \u251c\u2500\u2500 supabase.py            # Supabase client\n\u2502       \u2502   \u2514\u2500\u2500 web.py                 # HTTP client, retry/timeout\n\u2502       \u251c\u2500\u2500 repositories/              # data access\n\u2502       \u2502   \u251c\u2500\u2500 task_repo.py           # research_tasks CRUD\n\u2502       \u2502   \u2514\u2500\u2500 source_repo.py         # sources CRUD\n\u2502       \u251c\u2500\u2500 eval/                      # LangSmith eval datasets + evaluators\n\u2502       \u2502   \u251c\u2500\u2500 datasets.py\n\u2502       \u2502   \u251c\u2500\u2500 evaluators.py\n\u2502       \u2502   \u2514\u2500\u2500 run_eval.py\n\u2502       \u2514\u2500\u2500 workers/                   # background jobs\n\u2502           \u2514\u2500\u2500 research_worker.py     # async task runner\n\u251c\u2500\u2500 supabase/\n\u2502   \u2514\u2500\u2500 migrations/\n\u2502       \u2514\u2500\u2500 0001_init.sql              # tables, enum, indexes, RLS\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 conftest.py\n\u2502   \u2514\u2500\u2500 unit/  \u00b7  integration/  \u00b7  e2e/\n\u2514\u2500\u2500 alembic/                           # optional, if you outgrow Supabase migrations",
