    {
      "id": "p_db10_b",
      "type": "text",
      "x": 24,
      "y": 8395,
      "width": 551,
      "height": 422,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "from langsmith import Client\nfrom langsmith.evaluation import evaluate\n\nfrom research_agent.services.orchestrator import run_research\n\nclient = Client()\nDATASET = \"research-agent-golden\"\n\nasync def _noop(*_) -> None:\n    ...\n\nasync def target(inputs: dict) -> dict:\n    return await run_research(inputs[\"query\"], _noop)\n\ndef has_citations(run, example) -> dict:\n    report = run.outputs.get(\"final_report\", \"\")\n    return {\"key\": \"has_citations\", \"score\": int(\"http\" in report)}\n\nif __name__ == \"__main__\":\n    evaluate(\n        target,\n        data=DATASET,\n        evaluators=[has_citations],   # + LLM-as-judge evaluators\n        experiment_prefix=\"research-agent\",\n        client=client,\n    )",
      "originalText": "from langsmith import Client\nfrom langsmith.evaluation import evaluate\n\nfrom research_agent.services.orchestrator import run_research\n\nclient = Client()\nDATASET = \"research-agent-golden\"\n\nasync def _noop(*_) -> None:\n    ...\n\nasync def target(inputs: dict) -> dict:\n    return await run_research(inputs[\"query\"], _noop)\n\ndef has_citations(run, example) -> dict:\n    report = run.outputs.get(\"final_report\", \"\")\n    return {\"key\": \"has_citations\", \"score\": int(\"http\" in report)}\n\nif __name__ == \"__main__\":\n    evaluate(\n        target,\n        data=DATASET,\n        evaluators=[has_citations],   # + LLM-as-judge evaluators\n        experiment_prefix=\"research-agent\",\n        client=client,\n    )",
