      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "create extension if not exists \"pgcrypto\";\ncreate extension if not exists vector;          -- optional: embeddings\n\ncreate type research_status as enum (\n    'pending', 'searching', 'scraping',\n    'synthesizing', 'completed', 'failed');\n\ncreate table research_tasks (\n    id            uuid primary key default gen_random_uuid(),\n    query         text            not null,\n    status        research_status not null default 'pending',\n    sources       jsonb           not null default '[]'::jsonb,\n    final_report  text,\n    error         text,\n    created_at    timestamptz     not null default now(),\n    updated_at    timestamptz     not null default now()\n);\n\ncreate table sources (\n    id              uuid primary key default gen_random_uuid(),\n    research_id     uuid not null\n                    references research_tasks(id) on delete cascade,\n    url             text not null,\n    title           text,\n    snippet         text,\n    scraped_content text,\n    embedding       vector(1536),\n    created_at      timestamptz not null default now(),\n    unique (research_id, url)\n);\n\ncreate index on sources (research_id);\ncreate index on research_tasks (status, created_at desc);\n\nalter table research_tasks enable row level security;\nalter table sources        enable row level security;\n-- the service-role key bypasses RLS; add per-user\n-- policies once auth is wired up.",
      "originalText": "create extension if not exists \"pgcrypto\";\ncreate extension if not exists vector;          -- optional: embeddings\n\ncreate type research_status as enum (\n    'pending', 'searching', 'scraping',\n    'synthesizing', 'completed', 'failed');\n\ncreate table research_tasks (\n    id            uuid primary key default gen_random_uuid(),\n    query         text            not null,\n    status        research_status not null default 'pending',\n    sources       jsonb           not null default '[]'::jsonb,\n    final_report  text,\n    error         text,\n    created_at    timestamptz     not null default now(),\n    updated_at    timestamptz     not null default now()\n);\n\ncreate table sources (\n    id              uuid primary key default gen_random_uuid(),\n    research_id     uuid not null\n                    references research_tasks(id) on delete cascade,\n    url             text not null,\n    title           text,\n    snippet         text,\n    scraped_content text,\n    embedding       vector(1536),\n    created_at      timestamptz not null default now(),\n    unique (research_id, url)\n);\n\ncreate index on sources (research_id);\ncreate index on research_tasks (status, created_at desc);\n\nalter table research_tasks enable row level security;\nalter table sources        enable row level security;\n-- the service-role key bypasses RLS; add per-user\n-- policies once auth is wired up.",
