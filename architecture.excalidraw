    {
      "id": "p_plan1_b",
      "type": "text",
      "x": 28,
      "y": 2744,
      "width": 452,
      "height": 245,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 14,
      "fontFamily": 3,
      "text": "PHASE 1 \u2014 FOUNDATION\n[ ] 1. Project layout + FastAPI app factory\n[ ] 2. pydantic-settings + .env\n       GROQ / TAVILY / SUPABASE / LANGSMITH keys\n[ ] 3. Supabase client + repositories\n[ ] 4. Pydantic schemas for /research\n\nPHASE 2 \u2014 AGENTS & TOOLS\n[ ] 5. @tool: search_web, scrape_content, summarize\n[ ] 6. Search Agent (Tavily) \u2014 returns sources\n[ ] 7. Scraper Agent \u2014 BeautifulSoup full content\n[ ] 8. Synthesis / Writer Agent \u2014 final report\n[ ] 9. Orchestrator: route + tool loop + aggregate\n[ ] 10. Model routing per agent (Groq)",
      "originalText": "PHASE 1 \u2014 FOUNDATION\n[ ] 1. Project layout + FastAPI app factory\n[ ] 2. pydantic-settings + .env\n       GROQ / TAVILY / SUPABASE / LANGSMITH keys\n[ ] 3. Supabase client + repositories\n[ ] 4. Pydantic schemas for /research\n\nPHASE 2 \u2014 AGENTS & TOOLS\n[ ] 5. @tool: search_web, scrape_content, summarize\n[ ] 6. Search Agent (Tavily) \u2014 returns sources\n[ ] 7. Scraper Agent \u2014 BeautifulSoup full content\n[ ] 8. Synthesis / Writer Agent \u2014 final report\n[ ] 9. Orchestrator: route + tool loop + aggregate\n[ ] 10. Model routing per agent (Groq)",
      "textAlign": "left",
