    {
      "id": "p_db6_b",
      "type": "text",
      "x": 24,
      "y": 7047,
      "width": 551,
      "height": 520,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "import asyncio\nimport json\nfrom collections import defaultdict\nfrom dataclasses import dataclass\n\n@dataclass\nclass Event:\n    name: str          # searching | scraping | ... | done | error\n    data: dict\n\n# in-process fan-out; swap for Redis pub/sub when you\n# run more than one worker.\n_subs: dict[str, list[asyncio.Queue]] = defaultdict(list)\n\nasync def publish(research_id: str, name: str, data: dict) -> None:\n    for q in _subs[research_id]:\n        q.put_nowait(Event(name, data))\n\nasync def subscribe(research_id: str):\n    q: asyncio.Queue = asyncio.Queue()\n    _subs[research_id].append(q)\n    try:\n        while True:\n            ev = await q.get()\n            yield ev\n            if ev.name in (\"done\", \"error\"):\n                return\n    finally:\n        _subs[research_id].remove(q)\n\ndef sse(ev: Event) -> str:\n    return f\"event: {ev.name}\\ndata: {json.dumps(ev.data)}\\n\\n\"",
      "originalText": "import asyncio\nimport json\nfrom collections import defaultdict\nfrom dataclasses import dataclass\n\n@dataclass\nclass Event:\n    name: str          # searching | scraping | ... | done | error\n    data: dict\n\n# in-process fan-out; swap for Redis pub/sub when you\n# run more than one worker.\n_subs: dict[str, list[asyncio.Queue]] = defaultdict(list)\n\nasync def publish(research_id: str, name: str, data: dict) -> None:\n    for q in _subs[research_id]:\n        q.put_nowait(Event(name, data))\n\nasync def subscribe(research_id: str):\n    q: asyncio.Queue = asyncio.Queue()\n    _subs[research_id].append(q)\n    try:\n        while True:\n            ev = await q.get()\n            yield ev\n            if ev.name in (\"done\", \"error\"):\n                return\n    finally:\n        _subs[research_id].remove(q)\n\ndef sse(ev: Event) -> str:\n    return f\"event: {ev.name}\\ndata: {json.dumps(ev.data)}\\n\\n\"",
