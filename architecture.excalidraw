    {
      "id": "p_db8_b",
      "type": "text",
      "x": 24,
      "y": 7713,
      "width": 526,
      "height": 536,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "from contextlib import asynccontextmanager\n\nfrom fastapi import FastAPI\nfrom fastapi.middleware.cors import CORSMiddleware\n\nfrom research_agent.api.v1.router import api_router\nfrom research_agent.config.settings import get_settings\nfrom research_agent.integrations.langsmith import init_tracing\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    init_tracing()              # LangSmith on, once per process\n    yield\n\ndef create_app() -> FastAPI:\n    s = get_settings()\n    app = FastAPI(title=\"Research Agent\", version=\"0.1.0\",\n                  lifespan=lifespan)\n    app.add_middleware(\n        CORSMiddleware,\n        allow_origins=s.cors_origins,\n        allow_methods=[\"*\"],\n        allow_headers=[\"*\"],\n    )\n    app.include_router(api_router, prefix=\"/api/v1\")\n\n    @app.get(\"/health\")\n    async def health():\n        return {\"status\": \"ok\"}\n\n    return app\n\napp = create_app()",
      "originalText": "from contextlib import asynccontextmanager\n\nfrom fastapi import FastAPI\nfrom fastapi.middleware.cors import CORSMiddleware\n\nfrom research_agent.api.v1.router import api_router\nfrom research_agent.config.settings import get_settings\nfrom research_agent.integrations.langsmith import init_tracing\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    init_tracing()              # LangSmith on, once per process\n    yield\n\ndef create_app() -> FastAPI:\n    s = get_settings()\n    app = FastAPI(title=\"Research Agent\", version=\"0.1.0\",\n                  lifespan=lifespan)\n    app.add_middleware(\n        CORSMiddleware,\n        allow_origins=s.cors_origins,\n        allow_methods=[\"*\"],\n        allow_headers=[\"*\"],\n    )\n    app.include_router(api_router, prefix=\"/api/v1\")\n\n    @app.get(\"/health\")\n    async def health():\n        return {\"status\": \"ok\"}\n\n    return app\n\napp = create_app()",
