    {
      "id": "p_code3_b",
      "type": "text",
      "x": 892,
      "y": 3868,
      "width": 543,
      "height": 422,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "from langsmith import traceable\n\nfrom research_agent.agents.base import search_agent, scraper_agent\nfrom research_agent.agents.synthesis_agent import synthesis_agent\n\nasync def _run(agent, prompt: str) -> str:\n    out = await agent.ainvoke(\n        {\"messages\": [{\"role\": \"user\", \"content\": prompt}]}\n    )\n    return out[\"messages\"][-1].content\n\n@traceable(name=\"research-pipeline\")\nasync def run_research(query: str, emit) -> dict:\n    await emit(\"searching\", query)\n    sources = await _run(search_agent, query)\n\n    await emit(\"scraping\", sources)\n    content = await _run(scraper_agent, sources)\n\n    await emit(\"synthesizing\", None)\n    report = await _run(\n        synthesis_agent,\n        f\"Question: {query}\\n\\nSources:\\n{content}\\n\\n\"\n        \"Write a cited report.\",\n    )\n    return {\"sources\": sources, \"final_report\": report}",
      "originalText": "from langsmith import traceable\n\nfrom research_agent.agents.base import search_agent, scraper_agent\nfrom research_agent.agents.synthesis_agent import synthesis_agent\n\nasync def _run(agent, prompt: str) -> str:\n    out = await agent.ainvoke(\n        {\"messages\": [{\"role\": \"user\", \"content\": prompt}]}\n    )\n    return out[\"messages\"][-1].content\n\n@traceable(name=\"research-pipeline\")\nasync def run_research(query: str, emit) -> dict:\n    await emit(\"searching\", query)\n    sources = await _run(search_agent, query)\n\n    await emit(\"scraping\", sources)\n    content = await _run(scraper_agent, sources)\n\n    await emit(\"synthesizing\", None)\n    report = await _run(\n        synthesis_agent,\n        f\"Question: {query}\\n\\nSources:\\n{content}\\n\\n\"\n        \"Write a cited report.\",\n    )\n    return {\"sources\": sources, \"final_report\": report}",
