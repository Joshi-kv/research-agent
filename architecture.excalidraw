    {
      "id": "p_db7_b",
      "type": "text",
      "x": 892,
      "y": 6657,
      "width": 534,
      "height": 422,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "from research_agent.core.enums import StatusEnum\nfrom research_agent.repositories import source_repo, task_repo\nfrom research_agent.services.orchestrator import run_research\nfrom research_agent.services.streaming import publish\n\nasync def run_task(research_id: str) -> None:\n    task = task_repo.fetch_task(research_id)\n\n    async def emit(stage: str, payload) -> None:\n        task_repo.update_task(research_id, status=stage)\n        await publish(research_id, stage, {\"payload\": payload})\n\n    try:\n        result = await run_research(task[\"query\"], emit)\n        source_repo.bulk_upsert(research_id, result[\"sources\"])\n        task_repo.update_task(\n            research_id,\n            status=StatusEnum.COMPLETED,\n            final_report=result[\"final_report\"],\n        )\n        await publish(research_id, \"done\", {\"id\": research_id})\n    except Exception as exc:\n        task_repo.update_task(research_id,\n                              status=StatusEnum.FAILED,\n                              error=str(exc))\n        await publish(research_id, \"error\", {\"detail\": str(exc)})",
      "originalText": "from research_agent.core.enums import StatusEnum\nfrom research_agent.repositories import source_repo, task_repo\nfrom research_agent.services.orchestrator import run_research\nfrom research_agent.services.streaming import publish\n\nasync def run_task(research_id: str) -> None:\n    task = task_repo.fetch_task(research_id)\n\n    async def emit(stage: str, payload) -> None:\n        task_repo.update_task(research_id, status=stage)\n        await publish(research_id, stage, {\"payload\": payload})\n\n    try:\n        result = await run_research(task[\"query\"], emit)\n        source_repo.bulk_upsert(research_id, result[\"sources\"])\n        task_repo.update_task(\n            research_id,\n            status=StatusEnum.COMPLETED,\n            final_report=result[\"final_report\"],\n        )\n        await publish(research_id, \"done\", {\"id\": research_id})\n    except Exception as exc:\n        task_repo.update_task(research_id,\n                              status=StatusEnum.FAILED,\n                              error=str(exc))\n        await publish(research_id, \"error\", {\"detail\": str(exc)})",
