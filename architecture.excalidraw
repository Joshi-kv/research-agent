      "text": "import os\n\nfrom langsmith import Client\n\nfrom research_agent.config.settings import get_settings\n\ndef init_tracing() -> Client | None:\n    \"\"\"Call once at startup \u2014 LangChain reads these env vars itself.\"\"\"\n    s = get_settings()\n    if not (s.langsmith_tracing and s.langsmith_api_key):\n        return None\n    os.environ[\"LANGSMITH_TRACING\"] = \"true\"\n    os.environ[\"LANGSMITH_API_KEY\"] = s.langsmith_api_key\n    os.environ[\"LANGSMITH_PROJECT\"] = s.langsmith_project\n    return Client()\n\ndef run_config(research_id: str) -> dict:\n    \"\"\"Pass to .ainvoke(config=...) so every run is\n    searchable in LangSmith by research task.\"\"\"\n    return {\n        \"run_name\": \"research\",\n        \"tags\": [\"research\", research_id],\n        \"metadata\": {\"research_id\": research_id},\n    }",
      "originalText": "import os\n\nfrom langsmith import Client\n\nfrom research_agent.config.settings import get_settings\n\ndef init_tracing() -> Client | None:\n    \"\"\"Call once at startup \u2014 LangChain reads these env vars itself.\"\"\"\n    s = get_settings()\n    if not (s.langsmith_tracing and s.langsmith_api_key):\n        return None\n    os.environ[\"LANGSMITH_TRACING\"] = \"true\"\n    os.environ[\"LANGSMITH_API_KEY\"] = s.langsmith_api_key\n    os.environ[\"LANGSMITH_PROJECT\"] = s.langsmith_project\n    return Client()\n\ndef run_config(research_id: str) -> dict:\n    \"\"\"Pass to .ainvoke(config=...) so every run is\n    searchable in LangSmith by research task.\"\"\"\n    return {\n        \"run_name\": \"research\",\n        \"tags\": [\"research\", research_id],\n        \"metadata\": {\"research_id\": research_id},\n    }",
